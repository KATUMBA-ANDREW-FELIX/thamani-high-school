# Application Domain Configuration
DOMAIN=thamaniacademy.work.gd

# Reverse Proxy Docker Network (e.g., proxy, web, traefik)
PROXY_NETWORK=proxy

# PostgreSQL Database Configuration
DB_CONNECTION=pgsql
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=thamani_postgress
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Optional Ego SMS API Defaults (can also be configured in Admin Dashboard -> SMS Centre)
EGO_SMS_API_URL=https://comms.egosms.co/api/v1/json/
EGO_SMS_USERNAME=
EGO_SMS_PASSWORD=
